    openBtn.BorderSizePixel = 0
    openBtn.ZIndex = 104
    openBtn.Parent = container
    do local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0,6) c.Parent = openBtn end

    -- Dropdown frame - parented to GUI so it doesn't get clipped
    local dropdown = Instance.new("Frame")
    dropdown.Size = UDim2.new(0,252,0,0)
    dropdown.BackgroundColor3 = Color3.fromRGB(10,10,22)
    dropdown.BorderSizePixel = 0
    dropdown.ZIndex = 500
    dropdown.Visible = false
    dropdown.Parent = GUI
    do
        local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0,8) c.Parent = dropdown
        local s = Instance.new("UIStroke") s.Color = Color3.fromRGB(60,60,120) s.Thickness = 1 s.Parent = dropdown
        local sc = Instance.new("ScrollingFrame")
        sc.Name = "InnerScroll"
        sc.Size = UDim2.new(1,0,1,0)
        sc.BackgroundTransparency = 1
        sc.BorderSizePixel = 0
        sc.ScrollBarThickness = 2
        sc.ScrollBarImageColor3 = Color3.fromRGB(100,60,200)
        sc.CanvasSize = UDim2.new(0,0,0,0)
        sc.AutomaticCanvasSize = Enum.AutomaticSize.Y
        sc.ZIndex = 501
        sc.Parent = dropdown
        local l = Instance.new("UIListLayout")
        l.Padding = UDim.new(0,2)
        l.SortOrder = Enum.SortOrder.LayoutOrder
        l.Parent = sc
        local p = Instance.new("UIPadding")
        p.PaddingLeft = UDim.new(0,4)
        p.PaddingRight = UDim.new(0,4)
        p.PaddingTop = UDim.new(0,4)
        p.PaddingBottom = UDim.new(0,4)
        p.Parent = sc
    end

    local isOpen = false

    local function CloseDropdown()
        isOpen = false
        dropdown.Visible = false
        openBtn.Text = "▼"
    end

    local function OpenDropdown()
        isOpen = true
        openBtn.Text = "▲"

        -- Position dropdown below the button
        local absPos = container.AbsolutePosition
        local absSize = container.AbsoluteSize
        dropdown.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y + 4)
        dropdown.Visible = true

        -- Clear and repopulate
        local sc = dropdown:FindFirstChild("InnerScroll")
        if not sc then return end
        for _, v in ipairs(sc:GetChildren()) do
            if v:IsA("TextButton") or v:IsA("TextLabel") then v:Destroy() end
        end

        -- Get fresh player list every time
        local playerList = Players:GetPlayers()
        local count = 0

        for _, p in ipairs(playerList) do
            if p == Player then continue end
            count = count + 1
            local pb = Instance.new("TextButton")
            pb.Size = UDim2.new(1,0,0,30)
            pb.BackgroundColor3 = Color3.fromRGB(18,18,38)
            pb.Text = "  👤 "..p.Name
            pb.TextColor3 = Color3.fromRGB(220,220,255)
            pb.Font = Enum.Font.GothamBold
            pb.TextSize = 11
            pb.TextXAlignment = Enum.TextXAlignment.Left
            pb.BorderSizePixel = 0
            pb.ZIndex = 502
            pb.LayoutOrder = count
            pb.Parent = sc
            do local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0,6) c.Parent = pb end

            local captured = p
            pb.MouseButton1Click:Connect(function()
                CloseDropdown()
                onSelect(captured)
            end)
        end

        if count == 0 then
            local noP = Instance.new("TextLabel")
            noP.Size = UDim2.new(1,0,0,30)
            noP.BackgroundTransparency = 1
            noP.Text = "  No other players in server"
            noP.TextColor3 = Color3.fromRGB(100,100,150)
            noP.Font = Enum.Font.Gotham
            noP.TextSize = 10
            noP.ZIndex = 502
            noP.Parent = sc
        end

        -- Set dropdown height (max 5 players visible)
        local h = math.min(count, 5) * 32 + 10
        if count == 0 then h = 40 end
        dropdown.Size = UDim2.new(0,252,0,h)
    end

    openBtn.MouseButton1Click:Connect(function()
        if isOpen then CloseDropdown() else OpenDropdown() end
    end)

    -- Close when clicking elsewhere
    GUI.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            if isOpen then
                -- Check if click is outside dropdown
                local mousePos = UserInputService:GetMouseLocation()
                local dpPos = dropdown.AbsolutePosition
                local dpSize = dropdown.AbsoluteSize
                if mousePos.X < dpPos.X or mousePos.X > dpPos.X + dpSize.X or
                   mousePos.Y < dpPos.Y or mousePos.Y > dpPos.Y + dpSize.Y then
                    CloseDropdown()
                end
            end
        end
    end)

    return CloseDropdown
end

