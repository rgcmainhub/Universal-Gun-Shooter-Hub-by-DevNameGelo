-- ========== ULTIMATE GOD MODE (FF + Health Hack + Invincible) ==========
local function ApplyGodMode(on)
    GodModeEnabled = on
    if GodConn then GodConn:Disconnect() GodConn = nil end
    if FF_Object then pcall(function() FF_Object:Destroy() end) FF_Object = nil end

    if on then
        if not Char.Model or not Char.Humanoid then return end

        -- 1. Add ForceField
        FF_Object = Instance.new("ForceField")
        FF_Object.Visible = true
        FF_Object.Parent = Char.Model

