-- Mobile-friendly fly loop using MoveDirection properly
RunService.RenderStepped:Connect(function()
    if not FlyEnabled then return end
    if not FlyChar or not FlyHum or not FlyRoot then return end
    if not FlyVel or not FlyVel.Parent then StartFly() return end

    local moveDir = FlyHum.MoveDirection -- This is reliable on both mobile + PC

    if moveDir.Magnitude > 0.1 then
        -- Use camera-relative direction
        local camCF = Camera.CFrame
        local camFwd = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
        if camFwd.Magnitude > 0 then camFwd = camFwd.Unit end
        local camRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
        if camRight.Magnitude > 0 then camRight = camRight.Unit end

        -- moveDir is already in world space relative to camera, so just use it directly
        local flyDir = Vector3.new(moveDir.X, 0, moveDir.Z)
        if flyDir.Magnitude > 0 then flyDir = flyDir.Unit end

        -- Add upward component when looking up
        local upComponent = camCF.LookVector.Y
        local finalDir = (flyDir + Vector3.new(0, upComponent * 0.7, 0))
        if finalDir.Magnitude > 0 then finalDir = finalDir.Unit end

        FlyVel.VectorVelocity = finalDir * FlySpeed

        -- Smooth orientation (use AlignOrientation to prevent shake)
        if FlyGyro then
            local lookTarget = FlyRoot.Position + Vector3.new(flyDir.X, 0, flyDir.Z)
            FlyGyro.CFrame = CFrame.lookAt(FlyRoot.Position, lookTarget) * CFrame.Angles(math.rad(-15), 0, 0)
        end
    else
        FlyVel.VectorVelocity = Vector3.zero
        if FlyGyro then
            FlyGyro.CFrame = CFrame.lookAt(FlyRoot.Position, FlyRoot.Position + Camera.CFrame.LookVector * Vector3.new(1,0,1))
        end
    end
end)

