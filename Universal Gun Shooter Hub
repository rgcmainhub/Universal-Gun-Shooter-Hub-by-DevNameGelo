    trBG.ZIndex = 103
    trBG.Parent = card
    do local c = Instance.new("UICorner") c.CornerRadius = UDim.new(1,0) c.Parent = trBG end
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((defV-minV)/(maxV-minV),0,1,0)
    fill.BorderSizePixel = 0
    fill.ZIndex = 104
    fill.Parent = trBG
    do
        local c = Instance.new("UICorner") c.CornerRadius = UDim.new(1,0) c.Parent = fill
        local g = Instance.new("UIGradient")
        g.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(220,30,30)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(0,140,255)),
        })
        g.Parent = fill
    end
    local hnd = Instance.new("Frame")
    hnd.Size = UDim2.new(0,14,0,14)
    hnd.AnchorPoint = Vector2.new(0.5,0.5)
    hnd.Position = UDim2.new((defV-minV)/(maxV-minV),0,0.5,0)
    hnd.BackgroundColor3 = Color3.fromRGB(255,255,255)
    hnd.BorderSizePixel = 0
    hnd.ZIndex = 105
    hnd.Parent = trBG
