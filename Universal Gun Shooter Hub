-- ========== FLY (MOBILE-FRIENDLY, NO SHAKING) ==========
local function SetupFlyCharacter(c)
    FlyChar = c
    FlyHum = c:WaitForChild("Humanoid")
    FlyRoot = c:WaitForChild("HumanoidRootPart")
    local UpperTorso = c:FindFirstChild("UpperTorso")
    if UpperTorso then
        FlyRightShoulder = UpperTorso:FindFirstChild("RightShoulder")
        FlyLeftShoulder = UpperTorso:FindFirstChild("LeftShoulder")
    end
end

local function StartFly()
    if not FlyRoot then return end
    if FlyAtt then pcall(function() FlyAtt:Destroy() end) end
    if FlyVel then pcall(function() FlyVel:Destroy() end) end
    if FlyGyro then pcall(function() FlyGyro:Destroy() end) end

    FlyAtt = Instance.new("Attachment")
    FlyAtt.Parent = FlyRoot

    FlyVel = Instance.new("LinearVelocity")
    FlyVel.Attachment0 = FlyAtt
    FlyVel.RelativeTo = Enum.ActuatorRelativeTo.World
    FlyVel.MaxForce = math.huge
    FlyVel.VectorVelocity = Vector3.zero
    FlyVel.Parent = FlyRoot

    -- BodyGyro stabilizer (prevents shaking)
    FlyGyro = Instance.new("AlignOrientation")
    FlyGyro.Attachment0 = FlyAtt
    FlyGyro.Mode = Enum.OrientationAlignmentMode.OneAttachment
    FlyGyro.Responsiveness = 50
    FlyGyro.MaxTorque = math.huge
    FlyGyro.Parent = FlyRoot

    if FlyRightShoulder then
        FlyRightShoulder.Transform = CFrame.Angles(math.rad(-90), 0, 0)
    end
    if FlyLeftShoulder then
        FlyLeftShoulder.Transform = CFrame.Angles(math.rad(-90), 0, 0)
    end
end

local function StopFly()
    if FlyVel then pcall(function() FlyVel:Destroy() end) FlyVel = nil end
    if FlyAtt then pcall(function() FlyAtt:Destroy() end) FlyAtt = nil end
    if FlyGyro then pcall(function() FlyGyro:Destroy() end) FlyGyro = nil end
    if FlyRightShoulder then FlyRightShoulder.Transform = CFrame.new() end
    if FlyLeftShoulder then FlyLeftShoulder.Transform = CFrame.new() end
end

