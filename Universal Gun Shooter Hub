-- ========== WALL CHECK / AIM HELPERS ==========
local function HasWall(tRoot)
    if not Char.Root or not tRoot then return false end
    local origin = Char.Root.Position
    local dir = tRoot.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {Char.Model}
    local res = workspace:Raycast(origin, dir, params)
    if res then
        if res.Distance < dir.Magnitude - 2 then
            local isP = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and res.Instance:IsDescendantOf(p.Character) then isP = true break end
            end
            if not isP then return true end
        end
    end
    return false
end

local function IsPlayerBehindMe(target)
    if not Char.Root or not target.Character then return false end
    local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
    if not tRoot then return false end
    local toTarget = (tRoot.Position - Char.Root.Position).Unit
    local dot = toTarget:Dot(Char.Root.CFrame.LookVector)
    return dot < -0.3
end

local function GetClosestEnemy()
    if not Char.Root then return nil end
    local closest, closestD = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == Player then continue end
        if not p.Character then continue end
        local r = p.Character:FindFirstChild("HumanoidRootPart")
        if not r then continue end
        local h = p.Character:FindFirstChild("Humanoid")
        if not h or h.Health <= 0 then continue end
        local d = (r.Position - Char.Root.Position).Magnitude
        if d < closestD then closestD = d closest = p end
    end
    return closest
end

local function GetRandomEnemy()
    local valid = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p == Player then continue end
        if not p.Character then continue end
        local r = p.Character:FindFirstChild("HumanoidRootPart")
        local h = p.Character:FindFirstChild("Humanoid")
        if r and h and h.Health > 0 then
            table.insert(valid, p)
        end
    end
    if #valid == 0 then return nil end
    return valid[math.random(1, #valid)]
end

-- ========== SMART TP (with safe distance above target) ==========
local function ApplySmartTP(on)
    SmartTPEnabled = on
    if SmartTPConn then SmartTPConn:Disconnect() SmartTPConn = nil end
    if on and AimbotEnabled then
        SmartTPConn = RunService.Heartbeat:Connect(function()
            if not SmartTPEnabled or not AimbotEnabled then return end
            if not Char.Root then return end
            local now = tick()
            if now - lastTPTime < TP_COOLDOWN then return end
            local target = GetClosestEnemy()
            if not target or not target.Character then return end
            local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
            if not tRoot then return end

            -- Position ABOVE and slightly BEHIND target (safe from first-person aim)
            local targetLook = tRoot.CFrame.LookVector
            local behindOffset = -targetLook * 4 -- behind
            local upOffset = Vector3.new(0, TP_DISTANCE, 0) -- safe height above
            local tpPos = tRoot.Position + behindOffset + upOffset

            pcall(function()
                Char.Root.CFrame = CFrame.new(tpPos, tRoot.Position)
            end)
            lastTPTime = now
        end)
        ShowNotice("Smart TP", "Active - safe distance above target", Color3.fromRGB(255,200,0))
    end
end

-- ========== AUTO TP (independent from Aim) ==========
local function ApplyAutoTP(on)
    AutoTPEnabled = on
    if AutoTPConn then AutoTPConn:Disconnect() AutoTPConn = nil end
    if on then
        -- Enable internal noclip + floating
        SetAutoTPNoclip(true)
        AutoTPConn = RunService.Heartbeat:Connect(function()
            if not AutoTPEnabled then return end
            if not Char.Root or not Char.Humanoid then return end
            local now = tick()
            if now - lastAutoTPTime < TP_COOLDOWN then return end

            local target
            if AutoTPMode == "Closest" then
                target = GetClosestEnemy()
            else
                target = GetRandomEnemy()
            end

            if not target or not target.Character then return end
            local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
            if not tRoot then return end

            -- Float above target at safe distance
            local upOffset = Vector3.new(0, TP_DISTANCE, 0)
            local tpPos = tRoot.Position + upOffset

            pcall(function()
                Char.Root.CFrame = CFrame.new(tpPos, tRoot.Position)
                -- Float: zero velocity
                Char.Root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end)
            lastAutoTPTime = now
        end)
        ShowNotice("Auto TP", "Active ["..AutoTPMode.."] - floating + noclip", Color3.fromRGB(0,255,180))
    else
        -- Disable only the auto-tp noclip, NOT manual noclip
        SetAutoTPNoclip(false)
        ShowNotice("Auto TP", "Disabled", Color3.fromRGB(200,200,200))
    end
end

-- ========== BEHIND DETECTION ==========
local function StartBehindDetection()
    if BehindConn then BehindConn:Disconnect() BehindConn = nil end
    BehindConn = RunService.Heartbeat:Connect(function()
        if not AimbotEnabled then return end
        if not Char.Root then return end
        local now = tick()
        if now - lastBehindAlert < BEHIND_COOLDOWN then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p == Player then continue end
            if not p.Character then continue end
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if not r then continue end
            local h = p.Character:FindFirstChild("Humanoid")
            if not h or h.Health <= 0 then continue end
            local dist = (r.Position - Char.Root.Position).Magnitude
            if dist > 60 then continue end
            if IsPlayerBehindMe(p) then
                lastBehindAlert = now
                ShowNotice("BEHIND YOU!", p.Name.." is "..math.floor(dist).." studs behind!", Color3.fromRGB(255,50,50), 3)
                break
            end
        end
    end)
end

