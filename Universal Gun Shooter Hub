-- ===================== KILL AURA =====================
local function ApplyKillAura(on)
    KillAuraEnabled = on
    if KillConn then KillConn:Disconnect() KillConn = nil end
    if on then
        KillConn = RunService.Heartbeat:Connect(function()
            if not Char.Root then return end
            local myPos = Char.Root.Position
            pcall(function()
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Humanoid") and obj.Health > 0 then
                        local model = obj.Parent
                        if not model or model == Char.Model then continue end
                        local root = model:FindFirstChild("HumanoidRootPart")
                            or model:FindFirstChild("Torso")
                            or model:FindFirstChild("UpperTorso")
                        if root then
                            if (root.Position - myPos).Magnitude <= 20 then
                                pcall(function() obj.Health = 0 end)
                                pcall(function() obj:TakeDamage(9999999) end)
                            end
                        end
                    end
                end
            end)
        end)
    end
end

