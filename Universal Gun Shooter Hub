    hbx.Position = UDim2.new(0,0,0.5,-15)
    hbx.BackgroundTransparency = 1
    hbx.Text = ""
    hbx.ZIndex = 106
    hbx.Parent = trBG
    local function DS(x)
        local rel = math.clamp((x - trBG.AbsolutePosition.X) / trBG.AbsoluteSize.X, 0, 1)
        curV = math.floor(minV + (maxV-minV) * rel)
        fill.Size = UDim2.new(rel,0,1,0)
        hnd.Position = UDim2.new(rel,0,0.5,0)
        vL.Text = tostring(curV)
        if cb then cb(curV) end
    end
    hbx.MouseButton1Down:Connect(function() sliding = true end)
    UserInputService.InputChanged:Connect(function(inp)
        if not sliding then return end
        if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
            DS(inp.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)
    hbx.MouseButton1Click:Connect(function() DS(UserInputService:GetMouseLocation().X) end)
end

