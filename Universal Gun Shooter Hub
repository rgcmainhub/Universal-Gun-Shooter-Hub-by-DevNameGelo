        phDragging = false
    end
end)

-- Global Input Changed for dragging
UserInputService.InputChanged:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
        -- Drag the toggle button
        if tbDragging and tbStartPos and tbStartUI then
            local delta = inp.Position - tbStartPos
            if math.abs(delta.X) > DRAG_THRESHOLD or math.abs(delta.Y) > DRAG_THRESHOLD then
                tbMoved = true
            end
            if tbMoved then
                TB.Position = UDim2.new(
                    tbStartUI.X.Scale,
                    tbStartUI.X.Offset + delta.X,
                    tbStartUI.Y.Scale,
                    tbStartUI.Y.Offset + delta.Y
                )
            end
        end
        -- Drag the panel
        if phDragging and phStartPos and phStartUI then
            local delta = inp.Position - phStartPos
            Panel.Position = UDim2.new(
                phStartUI.X.Scale,
                phStartUI.X.Offset + delta.X,
                phStartUI.Y.Scale,
                phStartUI.Y.Offset + delta.Y
            )
        end
    end
end)

