local function ShowNotice(title, text, color, duration)
    local col = color or Color3.fromRGB(0, 120, 255)
    local dur = duration or 3

    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 64)
    card.BackgroundColor3 = Color3.fromRGB(10, 10, 20)
    card.BorderSizePixel = 0
    card.BackgroundTransparency = 1
    card.Parent = NotifyHolder

    do
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 10)
        c.Parent = card
        local s = Instance.new("UIStroke")
        s.Thickness = 1.5
        s.Color = col
        s.Parent = card
    end

    local leftBar = Instance.new("Frame")
    leftBar.Size = UDim2.new(0, 3, 0.7, 0)
    leftBar.Position = UDim2.new(0, 0, 0.15, 0)
    leftBar.BackgroundColor3 = col
    leftBar.BorderSizePixel = 0
    leftBar.Parent = card
    do
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(1, 0)
        c.Parent = leftBar
    end

    local titleL = Instance.new("TextLabel")
    titleL.Size = UDim2.new(1, -16, 0, 22)
    titleL.Position = UDim2.new(0, 12, 0, 8)
    titleL.BackgroundTransparency = 1
    titleL.Text = title
    titleL.TextColor3 = col
    titleL.Font = Enum.Font.GothamBold
    titleL.TextSize = 12
    titleL.TextXAlignment = Enum.TextXAlignment.Left
    titleL.TextTransparency = 1
    titleL.Parent = card

    local textL = Instance.new("TextLabel")
    textL.Size = UDim2.new(1, -16, 0, 28)
    textL.Position = UDim2.new(0, 12, 0, 30)
    textL.BackgroundTransparency = 1
    textL.Text = text
    textL.TextColor3 = Color3.fromRGB(200, 200, 220)
    textL.Font = Enum.Font.Gotham
    textL.TextSize = 10
    textL.TextXAlignment = Enum.TextXAlignment.Left
    textL.TextWrapped = true
    textL.TextTransparency = 1
    textL.Parent = card

    -- Fade in
    TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {BackgroundTransparency = 0.15}):Play()
    TweenService:Create(titleL, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    TweenService:Create(textL, TweenInfo.new(0.3), {TextTransparency = 0}):Play()

    task.delay(dur - 0.5, function()
        TweenService:Create(card, TweenInfo.new(0.4, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play()
        TweenService:Create(titleL, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
        TweenService:Create(textL, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
        task.wait(0.5)
        card:Destroy()
    end)
end

