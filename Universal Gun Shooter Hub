-- ========== DRAG SYSTEM ==========
local tbDragging, tbMoved, tbStartPos, tbStartUI = false, false, nil, nil
local phDragging, phStartPos, phStartUI = false, nil, nil
local DRAG_THRESHOLD = 8

TB.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        tbDragging = true tbMoved = false
        tbStartPos = inp.Position
        tbStartUI = TB.Position
    end
end)
TB.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        if tbDragging and not tbMoved then SetOpen(not UIOpen) end
        tbDragging = false tbMoved = false
    end
end)

TopBar.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        phDragging = true
        phStartPos = inp.Position
        phStartUI = Panel.Position
    end
end)
TopBar.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        phDragging = false
    end
end)

UserInputService.InputChanged:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
        if tbDragging and tbStartPos and tbStartUI then
            local delta = inp.Position - tbStartPos
            if math.abs(delta.X) > DRAG_THRESHOLD or math.abs(delta.Y) > DRAG_THRESHOLD then tbMoved = true end
            if tbMoved then
                TB.Position = UDim2.new(tbStartUI.X.Scale, tbStartUI.X.Offset + delta.X, tbStartUI.Y.Scale, tbStartUI.Y.Offset + delta.Y)
            end
        end
        if phDragging and phStartPos and phStartUI then
            local delta = inp.Position - phStartPos
            Panel.Position = UDim2.new(phStartUI.X.Scale, phStartUI.X.Offset + delta.X, phStartUI.Y.Scale, phStartUI.Y.Offset + delta.Y)
        end
    end
end)

