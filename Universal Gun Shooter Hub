    titleL.Size = UDim2.new(1, -16, 0, 22) titleL.Position = UDim2.new(0, 12, 0, 6)
    titleL.BackgroundTransparency = 1 titleL.Text = title titleL.TextColor3 = col
    titleL.Font = Enum.Font.GothamBold titleL.TextSize = 12
    titleL.TextXAlignment = Enum.TextXAlignment.Left titleL.TextTransparency = 1
    titleL.Parent = card
    local textL = Instance.new("TextLabel")
    textL.Size = UDim2.new(1, -16, 0, 28) textL.Position = UDim2.new(0, 12, 0, 28)
    textL.BackgroundTransparency = 1 textL.Text = text
    textL.TextColor3 = Color3.fromRGB(200, 200, 220)
    textL.Font = Enum.Font.Gotham textL.TextSize = 10
    textL.TextXAlignment = Enum.TextXAlignment.Left
    textL.TextWrapped = true textL.TextTransparency = 1 textL.Parent = card
    TweenService:Create(card, TweenInfo.new(0.3), {BackgroundTransparency = 0.1}):Play()
    TweenService:Create(titleL, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    TweenService:Create(textL, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    task.delay(dur - 0.5, function()
        TweenService:Create(card, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
