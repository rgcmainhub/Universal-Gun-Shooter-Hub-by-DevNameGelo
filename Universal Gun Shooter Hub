-- ===================== TELEPORT =====================
local function TeleportTo(target)
    if not target then ShowNotice("Error", "Player not found!", Color3.fromRGB(255,60,60)) return end
    if not target.Character then ShowNotice("Error", target.Name.." has no character!", Color3.fromRGB(255,60,60)) return end
    local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
    if not tRoot then ShowNotice("Error", "Can't find root part!", Color3.fromRGB(255,60,60)) return end
    if not Char.Root then return end
    pcall(function()
        Char.Root.CFrame = tRoot.CFrame + Vector3.new(0, 3, 0)
    end)
    ShowNotice("Teleported", "Jumped to "..target.Name, Color3.fromRGB(0,200,100))
end

