-- Toggle Button Drag/Click
local tbDragging = false
local tbMoved = false
local tbStartPos = nil
local tbStartUI = nil
local DRAG_THRESHOLD = 8

TB.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        tbDragging = true
        tbMoved = false
        tbStartPos = inp.Position
        tbStartUI = TB.Position
    end
end)

TB.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        if tbDragging then
            -- If didn't move (or moved very little) = treat as click
            if not tbMoved then
                SetOpen(not UIOpen)
            end
        end
        tbDragging = false
        tbMoved = false
    end
end)

-- Panel Header Drag
local phDragging = false
local phStartPos = nil
local phStartUI = nil

PH.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        phDragging = true
        phStartPos = inp.Position
        phStartUI = Panel.Position
    end
end)

PH.InputEnded:Connect(function(inp)
