-- ===================== BEHIND DETECTION =====================
local function StartBehindDetection()
    if BehindConn then BehindConn:Disconnect() BehindConn = nil end
    BehindConn = RunService.Heartbeat:Connect(function()
        if not AimbotEnabled then return end
        if not Char.Root then return end
        local now = tick()
        if now - lastBehindAlert < BEHIND_COOLDOWN then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p == Player then continue end
            if not p.Character then continue end
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if not r then continue end
            local h = p.Character:FindFirstChild("Humanoid")
            if not h or h.Health <= 0 then continue end
            local dist = (r.Position - Char.Root.Position).Magnitude
            if dist > 60 then continue end
            if IsPlayerBehindMe(p) then
                lastBehindAlert = now
                local dist2 = math.floor(dist)
                ShowNotice("BEHIND YOU!", p.Name.." is "..dist2.." studs behind!", Color3.fromRGB(255,50,50), 3)
                break
            end
        end
    end)
end

