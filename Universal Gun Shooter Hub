local function UpdateESP()
    for _, target in ipairs(Players:GetPlayers()) do
        if target == Player then continue end
        if not ESPEnabled then DestroyESP(target) continue end
        if not target.Character then DestroyESP(target) continue end
        local tChar = target.Character
        local tRoot = tChar:FindFirstChild("HumanoidRootPart")
        if not tRoot then DestroyESP(target) continue end
        if not ESPObjects[target] then BuildESP(target) end
        local obj = ESPObjects[target]
        if not obj then continue end

        local walled = HasWall(tRoot)
        local fc = walled and Color3.fromRGB(200,20,20) or Color3.fromRGB(0,100,255)
        local oc = walled and Color3.fromRGB(255,60,60) or Color3.fromRGB(0,200,255)
        local lc = walled and Color3.fromRGB(255,50,50) or Color3.fromRGB(0,150,255)
        local bc = walled and Color3.fromRGB(255,50,50) or Color3.fromRGB(0,180,255)

        if obj.WL ~= walled then
            obj.WL = walled
            local ti = TweenInfo.new(0.25)
            TweenService:Create(obj.HL, ti, {FillColor=fc, OutlineColor=oc}):Play()
            TweenService:Create(obj.BS, ti, {Color=bc}):Play()
            TweenService:Create(obj.LF, ti, {BackgroundColor3=lc}):Play()
        end

        obj.HL.Adornee = tChar

        local tH = tChar:FindFirstChild("Humanoid")
        if tH then
            local hp = math.floor(tH.Health)
            local mhp = math.floor(tH.MaxHealth)
            obj.HPL.Text = "❤ "..hp.."/"..mhp
            local r2 = math.clamp(hp/math.max(mhp,1),0,1)
            obj.HPL.TextColor3 = Color3.fromRGB(math.floor((1-r2)*255), math.floor(r2*220), 60)
        end

        local vp = Camera.ViewportSize
        local sp, onS = Camera:WorldToScreenPoint(tRoot.Position)
        if onS then
            local sx,sy = vp.X/2, vp.Y
            local dx,dy = sp.X-sx, sp.Y-sy
            local dist = math.sqrt(dx*dx+dy*dy)
            obj.LF.Visible = true
            obj.LF.Size = UDim2.new(0,dist,0,1)
            obj.LF.Position = UDim2.new(0,sx,0,sy)
            obj.LF.Rotation = math.deg(math.atan2(dy,dx))
        else
            obj.LF.Visible = false
        end

        local minX,minY = math.huge,math.huge
        local maxX,maxY = -math.huge,-math.huge
        local anyV = false
        for _, part in ipairs(tChar:GetChildren()) do
            if part:IsA("BasePart") then
                local s2 = part.Size*0.5
                local pts = {
                    Vector3.new(s2.X,s2.Y,s2.Z),Vector3.new(-s2.X,s2.Y,s2.Z),
                    Vector3.new(s2.X,-s2.Y,s2.Z),Vector3.new(-s2.X,-s2.Y,s2.Z),
                    Vector3.new(s2.X,s2.Y,-s2.Z),Vector3.new(-s2.X,s2.Y,-s2.Z),
                    Vector3.new(s2.X,-s2.Y,-s2.Z),Vector3.new(-s2.X,-s2.Y,-s2.Z),
                }
                for _, pt in ipairs(pts) do
                    local scrP, vis = Camera:WorldToScreenPoint(part.Position+pt)
                    if vis then
                        anyV = true
                        if scrP.X < minX then minX = scrP.X end
                        if scrP.Y < minY then minY = scrP.Y end
                        if scrP.X > maxX then maxX = scrP.X end
                        if scrP.Y > maxY then maxY = scrP.Y end
                    end
                end
            end
        end
        if anyV then
            obj.BF.Visible = true
            obj.BF.Position = UDim2.new(0,minX-3,0,minY-3)
            obj.BF.Size = UDim2.new(0,(maxX-minX)+6,0,(maxY-minY)+6)
        else
            obj.BF.Visible = false
        end
    end
    for t in pairs(ESPObjects) do
        if not t or not t.Parent then DestroyESP(t) end
    end
end

