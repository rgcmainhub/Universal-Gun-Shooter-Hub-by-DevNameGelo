local function UpdateAim()
    if not AimbotEnabled then
        AimRing.Visible = false
        SDot.Visible = false
        SRing.Visible = false
        AimLbl.Visible = false
        TPStatusLbl.Visible = false
        return
    end

    AimRing.Visible = true

    -- Smart TP status
    if SmartTPEnabled then
        TPStatusLbl.Text = "⚡ SMART TP: ACTIVE"
        TPStatusLbl.Visible = true
    else
        TPStatusLbl.Visible = false
    end

    if SmartAimEnabled then
        local t = GetClosestEnemy()
        if t and t.Character then
            local r = t.Character:FindFirstChild("HumanoidRootPart")
            if r then
                local sp, onS = Camera:WorldToScreenPoint(r.Position)
                if onS then
                    SDot.Position = UDim2.new(0,sp.X,0,sp.Y)
                    SRing.Position = UDim2.new(0,sp.X,0,sp.Y)
                    SDot.Visible = true
                    SRing.Visible = true
                    AimLbl.Position = UDim2.new(0,sp.X,0,sp.Y+18)
                    AimLbl.Text = "⚔ "..t.Name
                    AimLbl.Visible = true
                    local dir = (r.Position - Camera.CFrame.Position).Unit
                    pcall(function()
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + dir)
                    end)
                    return
                end
            end
        end
        SDot.Visible = false
        SRing.Visible = false
        AimLbl.Visible = false
    else
        SDot.Visible = false
        SRing.Visible = false
        AimLbl.Visible = false
    end
end

