local function DestroyESP(target)
    if not ESPObjects[target] then return end
    local obj = ESPObjects[target]
    pcall(function() obj.HL:Destroy() end)
    pcall(function() obj.BB:Destroy() end)
    pcall(function() obj.LG:Destroy() end)
    pcall(function() obj.BG:Destroy() end)
    ESPObjects[target] = nil
end

local function ClearESP()
    for t in pairs(ESPObjects) do DestroyESP(t) end
end

